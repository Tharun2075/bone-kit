{
  "name": "@bone-kit/skeleton",
  "version": "0.1.0",
  "description": "Bone Kit skeleton: offline-first store, CRDT merge, SMS-sized payloads, connectivity lantern, i18n, Clear all, PWA config.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/base.css": "./src/styles/base.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:pbt": "vitest run test/*.pbt.test.ts"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
